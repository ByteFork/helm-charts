doublestar: true

formatter:
  type: basic
  indent: 2
  retain_line_breaks_single: true
  scan_folded_as_literal: true
  pad_line_comments: 1
  trim_trailing_whitespace: true
  eof_newline: true
  include_document_start: false

include:
  - "charts/**/*.yaml"
  - "charts/**/*.yml"
  - "Taskfile.yml"
  - ".ct/*.yaml"
  - ".github/**/*.yaml"
  - ".github/**/*.yml"

exclude:
  - "**/values.schema.json"
  - "charts/**/charts/**"
  - "charts/**/Chart.lock"
  - "charts/**/templates/**"
